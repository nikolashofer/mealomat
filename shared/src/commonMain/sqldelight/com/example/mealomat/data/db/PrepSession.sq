import com.example.mealomat.data.db.SessionStatus;

CREATE TABLE prep_session (
  id                   TEXT    NOT NULL PRIMARY KEY,
  user_id              TEXT    NOT NULL,
  prep_block_id        TEXT    NOT NULL,
  updated_at           INTEGER NOT NULL,
  deleted_at           INTEGER,
  started_at           INTEGER,
  completed_at         INTEGER,
  planned_date         TEXT    NOT NULL,
  covers_from_date     TEXT    NOT NULL,   -- the window this session prepped for, frozen at start
  covers_from_position INTEGER NOT NULL,
  covers_to_date       TEXT    NOT NULL,   -- exclusive: the next block's boundary
  covers_to_position   INTEGER NOT NULL,
  status               TEXT AS SessionStatus NOT NULL
);

CREATE INDEX prep_session_user_id ON prep_session(user_id);
CREATE INDEX prep_session_block ON prep_session(prep_block_id);
CREATE UNIQUE INDEX prep_session_open ON prep_session(user_id) WHERE status = 'IN_PROGRESS' AND deleted_at IS NULL;

insert:
INSERT INTO prep_session VALUES ?;

upsert:
INSERT OR REPLACE INTO prep_session VALUES ?;

listCommitted:
SELECT * FROM prep_session
WHERE deleted_at IS NULL AND status IN ('IN_PROGRESS', 'DONE') AND covers_to_date >= ?;

findById:
SELECT * FROM prep_session WHERE id = ?;

findOpen:
SELECT * FROM prep_session WHERE deleted_at IS NULL AND status = 'IN_PROGRESS';
