import com.example.mealomat.data.db.PrepMode;

CREATE TABLE plan_item (
  id                TEXT    NOT NULL PRIMARY KEY,
  user_id           TEXT    NOT NULL,
  plan_meal_id      TEXT    NOT NULL,
  plan_component_id TEXT,                    -- NULL = flat, directly on the meal
  ingredient_id     TEXT    NOT NULL,
  updated_at        INTEGER NOT NULL,
  deleted_at        INTEGER,
  amount            REAL    NOT NULL,        -- in the ingredient's basis unit
  position          INTEGER NOT NULL,
  prep_mode         TEXT AS PrepMode         -- NULL = inherit from the component
);

CREATE INDEX plan_item_user_id ON plan_item(user_id);
CREATE INDEX plan_item_meal ON plan_item(plan_meal_id);
CREATE INDEX plan_item_component ON plan_item(plan_component_id);

list:
SELECT * FROM plan_item WHERE deleted_at IS NULL ORDER BY plan_meal_id, position;

upsert:
INSERT OR REPLACE INTO plan_item VALUES ?;
