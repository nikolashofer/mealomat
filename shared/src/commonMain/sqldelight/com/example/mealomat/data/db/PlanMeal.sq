import kotlinx.datetime.DayOfWeek;

CREATE TABLE plan_meal (
  id         TEXT    NOT NULL PRIMARY KEY,
  user_id    TEXT    NOT NULL,
  plan_id    TEXT    NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  weekday    INTEGER AS DayOfWeek NOT NULL,
  name       TEXT    NOT NULL,
  position   INTEGER NOT NULL
);

CREATE INDEX plan_meal_user_id ON plan_meal(user_id);
CREATE INDEX plan_meal_plan ON plan_meal(plan_id);

upsert:
INSERT OR REPLACE INTO plan_meal VALUES ?;

softDelete:
UPDATE plan_meal SET deleted_at = ?, updated_at = ? WHERE id = ?;

listForPlan:
SELECT * FROM plan_meal WHERE deleted_at IS NULL AND plan_id = ? ORDER BY weekday, position;
